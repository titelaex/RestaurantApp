<Window x:Class="RestaurantApp.Views.ClientOrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:RestaurantApp.ViewModels"
        Title="Comenzile Mele" Height="600" Width="850" WindowStartupLocation="CenterScreen" Background="#F5F7FA">

    <Window.DataContext>
        <viewmodels:ClientOrdersViewModel />
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="ISTORIC ȘI URRMĂRIRE COMENZI" FontSize="20" FontWeight="Black" Foreground="#2C3E50" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <Button Content="Actualizează Lista" Command="{Binding RefreshCommand}" HorizontalAlignment="Right" Padding="15,5" Background="#2196F3" Foreground="White" FontWeight="Bold"/>
        </Grid>

        <ListBox Grid.Row="1" ItemsSource="{Binding IndexComenzi}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.1"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Background="#27AE60" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding CodUnic}" Foreground="White" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="{Binding DataComanda, StringFormat={}{0:dd MMM HH:mm}}" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                                    <TextBlock Text="  |  Stare: " Foreground="#7F8C8D" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Stare}" FontWeight="Black" VerticalAlignment="Center" x:Name="txtStare"/>
                                </StackPanel>

                                <TextBlock Text="PRODUSE COMANDATE:" FontSize="11" FontWeight="Bold" Foreground="#95A5A6" Margin="0,5,0,2"/>
                                <TextBlock Text="{Binding PreparateComandate}" FontSize="14" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding MeniuriComandate}" FontSize="13" Foreground="#2980B9" TextWrapping="Wrap" Margin="0,2,0,0"/>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="Livrare Estimată: " Foreground="Gray" FontSize="12"/>
                                    <TextBlock Text="{Binding OraEstimativaLivrare, StringFormat={}{0:HH:mm}}" FontWeight="Bold" Foreground="#D35400" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding CostTotal, StringFormat={}{0:0.00} LEI}" FontSize="22" FontWeight="Black" Foreground="#2C3E50" HorizontalAlignment="Right" Margin="0,0,0,10"/>

                                <Button Content="Anulează Comanda" 
                                        Command="{Binding DataContext.AnuleazaComandaCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        CommandParameter="{Binding}"
                                        x:Name="btnAnuleaza"
                                        Background="#E74C3C" Foreground="White" FontWeight="Bold" Padding="12,6" BorderThickness="0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Stare}" Value="inregistrata">
                            <Setter TargetName="txtStare" Property="Foreground" Value="#2980B9"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Stare}" Value="se pregateste">
                            <Setter TargetName="txtStare" Property="Foreground" Value="#E67E22"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Stare}" Value="a plecat la client">
                            <Setter TargetName="txtStare" Property="Foreground" Value="#9B59B6"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Stare}" Value="livrata">
                            <Setter TargetName="txtStare" Property="Foreground" Value="Green"/>
                            <Setter TargetName="btnAnuleaza" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Stare}" Value="anulata">
                            <Setter TargetName="txtStare" Property="Foreground" Value="Red"/>
                            <Setter TargetName="btnAnuleaza" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>