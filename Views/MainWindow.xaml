<Window x:Class="RestaurantApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:RestaurantApp.ViewModels"
        Title="Gestiune Restaurant - Meniu &amp; Comenzi" Height="650" Width="1100" WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="LightGray" BorderThickness="0,0,0,2" Padding="0,0,0,10" Margin="0,0,0,10">
            <Grid>
                <TextBlock Text="{Binding MesajSalut}" FontSize="16" FontWeight="Bold" Foreground="#2196F3" VerticalAlignment="Center"/>
                <TextBlock Text="RESTAURANT" FontSize="20" FontWeight="Black" HorizontalAlignment="Center"/>
                <Button Content="Panou Angajat" Command="{Binding DeschidePanouAngajatCommand}" 
                        Visibility="{Binding EsteAngajat, Converter={StaticResource BoolToVis}}" 
                        HorizontalAlignment="Right" Background="#FF5722" Foreground="White" Padding="10,2"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,15" Background="#F9F9F9">
            <TextBlock Text="Căutare:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
            <TextBox Width="200" Text="{Binding CuvantCheie, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,20,0" VerticalContentAlignment="Center"/>

            <TextBlock Text="După:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox ItemsSource="{Binding OptiuniTipCautare}" SelectedItem="{Binding TipCautareSelectat}" Width="100" Margin="0,0,20,0"/>

            <TextBlock Text="Mod:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox ItemsSource="{Binding OptiuniModCautare}" SelectedItem="{Binding ModCautareSelectat}" Width="100"/>
        </StackPanel>

        <TabControl Grid.Row="2" Grid.Column="0" Margin="0,0,10,0">

            <TabItem Header="Preparate Individuale">
                <ListBox ItemsSource="{Binding MeniuView}" HorizontalContentAlignment="Stretch" BorderThickness="0">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <StackPanel Margin="0,0,0,15">
                                                    <Border Background="#333333" Padding="10,5">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="18" Foreground="White" />
                                                    </Border>
                                                    <ItemsPresenter />
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Column="0" Source="{Binding ImaginePath}" Width="60" Height="60" Stretch="UniformToFill" Margin="0,0,15,0" RenderOptions.BitmapScalingMode="HighQuality"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Denumire}" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock Text="{Binding CantitatePortie, StringFormat={}{0}g}" Foreground="Gray"/>
                                        <TextBlock Text="{Binding TextAfisareAlergeni}" Foreground="#FF9800" FontSize="11" FontStyle="Italic"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding Pret, StringFormat={}{0:0.00} LEI}" FontWeight="Bold" Foreground="#4CAF50" VerticalAlignment="Center" Margin="10,0"/>

                                    <Grid Grid.Column="3" VerticalAlignment="Center">
                                        <Button x:Name="btnAdauga" Content="Adaugă" Command="{Binding DataContext.AdaugaInCosCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding DataContext.EsteClient, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" Background="#2196F3" Foreground="White"/>
                                        <TextBlock x:Name="txtIndisponibil" Text="INDISPONIBIL" Foreground="Red" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding EsteDisponibil}" Value="False">
                                    <Setter TargetName="btnAdauga" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="txtIndisponibil" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

            <TabItem Header="Meniuri Combo">
                <ListBox ItemsSource="{Binding MeniuriComboView}" HorizontalContentAlignment="Stretch" BorderThickness="0">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <StackPanel Margin="0,0,0,15">
                                                    <Border Background="#455A64" Padding="10,5">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="18" Foreground="White" />
                                                    </Border>
                                                    <ItemsPresenter />
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Column="0" Source="{Binding ImaginePath}" Width="60" Height="60" Stretch="UniformToFill" Margin="0,0,15,0" RenderOptions.BitmapScalingMode="HighQuality"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Denumire}" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock Text="{Binding DetaliiPreparate}" TextWrapping="Wrap" Foreground="Gray" FontSize="12"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0">
                                        <TextBlock Text="{Binding PretFaraReducere, StringFormat={}{0:0.00} LEI}" TextDecorations="Strikethrough" Foreground="Red" HorizontalAlignment="Right"/>
                                        <TextBlock Text="OFERTĂ!" FontWeight="Bold" Foreground="#4CAF50" HorizontalAlignment="Right"/>
                                    </StackPanel>

                                    <Grid Grid.Column="3" VerticalAlignment="Center">
                                        <Button x:Name="btnAdaugaMeniu" Content="Adaugă Meniu" Command="{Binding DataContext.AdaugaMeniuInCosCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding DataContext.EsteClient, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" Background="#4CAF50" Foreground="White"/>
                                        <TextBlock x:Name="txtIndisponibilMeniu" Text="INDISPONIBIL" Foreground="Red" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding EsteDisponibil}" Value="False">
                                    <Setter TargetName="btnAdaugaMeniu" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="txtIndisponibilMeniu" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Grid.Column="1" Width="350" BorderBrush="LightGray" BorderThickness="1" Background="#FAFAFA" Padding="15" 
                Visibility="{Binding EsteClient, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Coșul meu" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Preparate:" FontWeight="Bold" Foreground="Gray" Visibility="{Binding CosCumparaturi.Count, Converter={StaticResource BoolToVis}}"/>
                        <ListBox ItemsSource="{Binding CosCumparaturi}" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5" Width="300">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Preparat.Denumire}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Cantitate, StringFormat=x{0}}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Subtotal, StringFormat={}{0:0.00}}" HorizontalAlignment="Right" Foreground="#4CAF50"/>
                                        <Button Grid.Column="3" Content=" X " Command="{Binding DataContext.EliminaDinCosCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Foreground="Red" Background="Transparent" BorderThickness="0" Margin="5,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="Meniuri Combo:" FontWeight="Bold" Foreground="Gray" Margin="0,10,0,0" Visibility="{Binding CosMeniuri.Count, Converter={StaticResource BoolToVis}}"/>
                        <ListBox ItemsSource="{Binding CosMeniuri}" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5" Width="300">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Meniu.Denumire}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Cantitate, StringFormat=x{0}}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Subtotal, StringFormat={}{0:0.00}}" HorizontalAlignment="Right" Foreground="#4CAF50"/>
                                        <Button Grid.Column="3" Content=" X " Command="{Binding DataContext.EliminaMeniuDinCosCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Foreground="Red" Background="Transparent" BorderThickness="0" Margin="5,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="0,15,0,0">
                    <Separator Margin="0,0,0,10"/>
                    <Button Content="Vezi Comenzile Mele" Command="{Binding VeziComenziMeleCommand}" Margin="0,0,0,10" Background="#2196F3" Foreground="White"/>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Mâncare: "/>
                        <TextBlock Text="{Binding CostMancare, StringFormat={}{0:0.00} LEI}" FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Transport: "/>
                        <TextBlock Text="{Binding CostTransport, StringFormat={}{0:0.00} LEI}" FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Discount: " Foreground="Red"/>
                        <TextBlock Text="{Binding ValoareDiscount, StringFormat=-{0:0.00} LEI}" Foreground="Red" FontWeight="Bold"/>
                    </StackPanel>

                    <Separator Margin="0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="TOTAL: " FontSize="18" FontWeight="Black"/>
                        <TextBlock Text="{Binding TotalDePlata, StringFormat={}{0:0.00} LEI}" FontSize="18" FontWeight="Black" Foreground="#4CAF50"/>
                    </StackPanel>

                    <Button Content="Trimite Comanda" Command="{Binding TrimiteComandaCommand}" Margin="0,15,0,0" Padding="10" Background="#4CAF50" Foreground="White" FontSize="16" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>