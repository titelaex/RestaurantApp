<Window x:Class="RestaurantApp.Views.EmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:RestaurantApp.ViewModels"
        xmlns:core="clr-namespace:RestaurantApp.Core"
        Title="Panou Administrare Angajat" Height="700" Width="1100" WindowStartupLocation="CenterScreen" Background="#F5F7FA">
    
    <Window.Resources>
        <core:WeightConverter x:Key="WeightConverter"/>
        
        <Style x:Key="OrderCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <viewmodels:EmployeeViewModel />
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="GESTIUNE COMENZI ȘI STOCURI" FontSize="22" FontWeight="Black" Foreground="#2C3E50" HorizontalAlignment="Left" VerticalAlignment="Center"/>

            <Button Content="🔄 Actualizează Datele" 
                    Command="{Binding RefreshCommand}" 
                    HorizontalAlignment="Right" 
                    Padding="15,6" 
                    Background="#2196F3" 
                    Foreground="White" 
                    FontWeight="Bold" 
                    BorderThickness="0"/>
        </Grid>
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- TAB COMENZI ACTIVE (Card Design) -->
            <TabItem Header="COMENZI ACTIVE">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <ItemsControl ItemsSource="{Binding ComenziActiveView}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource OrderCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="250"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <Border Background="#2196F3" CornerRadius="4" Padding="8,2" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding CodUnic}" Foreground="White" FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Text="{Binding DataComanda, StringFormat={}{0:dd MMM HH:mm}}" VerticalAlignment="Center" Foreground="#7F8C8D"/>
                                            </StackPanel>

                                            <TextBlock Text="PRODUSE:" FontWeight="Bold" FontSize="11" Foreground="#95A5A6"/>
                                            <TextBlock Text="{Binding PreparateComandate}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                            <TextBlock Text="{Binding MeniuriComandate}" FontSize="13" Foreground="#2980B9" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                            <Separator Background="#ECF0F1" Margin="0,5"/>
                                            
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="👤 "/>
                                                <TextBlock Text="{Binding Nume}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Prenume}" Margin="5,0"/>
                                                <TextBlock Text=" | 📞 " Margin="10,0,0,0"/>
                                                <TextBlock Text="{Binding Telefon}" Foreground="#E67E22" FontWeight="Bold"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding AdresaLivrare}" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#34495E" FontStyle="Italic"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                                                <TextBlock Text="Livrare estimată: " FontSize="12" Foreground="Gray"/>
                                                <TextBlock Text="{Binding OraEstimativaLivrare, StringFormat={}{0:HH:mm}}" FontSize="12" FontWeight="Bold" Foreground="#D35400"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="Mâncare: " FontSize="11" Foreground="Gray"/>
                                                <TextBlock Text="{Binding CostMancare, StringFormat={}{0:0.00}}" FontSize="11" FontWeight="Bold" Margin="0,0,10,0"/>

                                                <TextBlock Text="Transport: " FontSize="11" Foreground="Gray"/>
                                                <TextBlock Text="{Binding CostTransport, StringFormat={}{0:0.00}}" FontSize="11" FontWeight="Bold"/>
                                            </StackPanel>

                                            <TextBlock Text="{Binding CostTotal, StringFormat={}{0:0.00} LEI}" FontSize="24" FontWeight="Black" Foreground="#27AE60" HorizontalAlignment="Right" Margin="0,5,0,15"/>

                                            <TextBlock Text="SCHIMBĂ STAREA:" FontSize="10" FontWeight="Bold" Margin="0,0,0,5" HorizontalAlignment="Right"/>
                                            <ComboBox ItemsSource="{Binding DataContext.OptiuniStare, RelativeSource={RelativeSource AncestorType=Window}}" 
                                              SelectedItem="{Binding Stare, UpdateSourceTrigger=PropertyChanged}"
                                              core:ComboBoxHelper.SelectionChangedCommand="{Binding DataContext.ActualizeazaStareCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Width="180" Height="35" VerticalContentAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="ISTORIC COMPLET">
                <DataGrid ItemsSource="{Binding ToateComenzile}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,10,0,0" 
                          Background="White" RowHeight="40" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F2F2F2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Data" Binding="{Binding DataComanda, StringFormat=dd.MM HH:mm}" Width="100"/>
                        <DataGridTextColumn Header="Cod" Binding="{Binding CodUnic}" Width="80"/>
                        <DataGridTextColumn Header="Produse" Binding="{Binding PreparateComandate}" Width="250">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Total" Binding="{Binding CostTotal, StringFormat={}{0:0.00}}" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Client" Binding="{Binding Nume}" Width="120"/>
                        <DataGridTextColumn Header="Stare" Binding="{Binding Stare}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Stare}" Value="livrata">
                                            <Setter Property="Foreground" Value="Green"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Stare}" Value="anulata">
                                            <Setter Property="Foreground" Value="Red"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- TAB STOCURI -->
            <TabItem Header="STOCURI">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Header="Stoc Complet" Margin="0,0,10,0" FontWeight="Bold">
                        <ListBox ItemsSource="{Binding StocComplet}" Background="Transparent" BorderThickness="0" Margin="0,10,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" CornerRadius="5" Margin="0,0,0,5" Padding="15">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Denumire}" FontWeight="Bold" FontSize="16" Width="300"/>
                                                <TextBlock Text="{Binding CantitatePortie, StringFormat={}– {0}g/portie}" Foreground="Gray" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding CantitateTotala, Converter={StaticResource WeightConverter}}" FontWeight="Black" Foreground="#2196F3" FontSize="16"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </GroupBox>

                    <GroupBox Grid.Column="1" Header="⚠️ ALERTE STOC CRITIC" FontWeight="Bold" Foreground="Red">
                        <ListBox ItemsSource="{Binding ProduseEpuizate}" Background="Transparent" BorderThickness="0" Margin="0,10,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFF3F3" BorderBrush="Red" BorderThickness="1" CornerRadius="5" Margin="0,0,0,5" Padding="10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Denumire}" FontWeight="Bold" Foreground="#C0392B"/>
                                            <TextBlock Text=" - " FontWeight="Bold" Foreground="#C0392B"/>
                                            <TextBlock Text="{Binding CantitateTotala, Converter={StaticResource WeightConverter}}" FontWeight="Black" Foreground="#C0392B"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </GroupBox>
                </Grid>
            </TabItem>
            <!-- TAB ADMIN -->
            <TabItem Header="ADMIN">
                <TabControl TabStripPlacement="Left" Margin="0,10,0,0">
                    <TabItem Header="Categorii">
                        <Grid Margin="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="300"/>
                            </Grid.ColumnDefinitions>
                            <ListBox ItemsSource="{Binding Categorii}" SelectedItem="{Binding CategorieSelectata}" Margin="0,0,15,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Editare Categorie" FontWeight="Bold" Margin="0,0,0,10"/>
                                <TextBox Text="{Binding NumeCategorieNoua, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,0,0,10"/>
                                <Button Content="ADĂUGĂ" Command="{Binding AdaugaCategorieCommand}" Height="30" Background="#4CAF50" Foreground="White" Margin="0,0,0,5"/>
                                <Button Content="MODIFICĂ" Command="{Binding ModificaCategorieCommand}" Height="30" Background="#2196F3" Foreground="White" Margin="0,0,0,5"/>
                                <Button Content="ȘTERGE" Command="{Binding StergeCategorieCommand}" Height="30" Background="#F44336" Foreground="White"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Alergeni">
                        <Grid Margin="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="300"/>
                            </Grid.ColumnDefinitions>
                            <ListBox ItemsSource="{Binding Alergeni}" Margin="0,0,15,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="400">
                                            <TextBlock Text="{Binding Denumire}" VerticalAlignment="Center" FontSize="14"/>
                                            <Button Content="Elimină" HorizontalAlignment="Right" Command="{Binding DataContext.StergeAlergenCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Foreground="Red" Background="Transparent" BorderThickness="0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Adăugare Alergen" FontWeight="Bold" Margin="0,0,0,10"/>
                                <TextBox Text="{Binding NumeAlergenNou, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,0,0,10"/>
                                <Button Content="SALVEAZĂ" Command="{Binding AdaugaAlergenCommand}" Height="30" Background="#4CAF50" Foreground="White"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
