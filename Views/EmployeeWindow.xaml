<Window x:Class="RestaurantApp.Views.EmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:RestaurantApp.ViewModels"
        Title="Panou Angajat" Height="600" Width="1000" WindowStartupLocation="CenterScreen">
    
    <Window.DataContext>
        <viewmodels:EmployeeViewModel />
    </Window.DataContext>

    <Grid Margin="15">
        <TabControl>
            <TabItem Header="Toate Comenzile">
                <DataGrid ItemsSource="{Binding ToateComenzile}" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Cod" Binding="{Binding CodUnic}" IsReadOnly="True" Width="100"/>
                        <DataGridTextColumn Header="Data" Binding="{Binding DataComanda, StringFormat=dd.MM HH:mm}" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Stare" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.OptiuniStare, RelativeSource={RelativeSource AncestorType=Window}}" 
                                              SelectedItem="{Binding Stare, UpdateSourceTrigger=PropertyChanged}">
                                        <ComboBox.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.ActualizeazaStareCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                        </ComboBox.InputBindings>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Client" Binding="{Binding Nume}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Telefon" Binding="{Binding Telefon}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Adresă" Binding="{Binding AdresaLivrare}" IsReadOnly="True" Width="*"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding CostTotal, StringFormat={}{0:0.00}}" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Produse Critice (Stoc mic)">
                <ListBox ItemsSource="{Binding ProduseEpuizate}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="5">
                                <TextBlock Text="{Binding Denumire}" FontWeight="Bold" Width="200"/>
                                <TextBlock Text="Stoc curent: " Foreground="Red"/>
                                <TextBlock Text="{Binding CantitateTotala}" FontWeight="Black" Foreground="Red"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
