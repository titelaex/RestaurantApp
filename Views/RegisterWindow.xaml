<Window x:Class="RestaurantApp.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:RestaurantApp.Core"
        xmlns:viewmodels="clr-namespace:RestaurantApp.ViewModels"
        x:Name="thisRegisterWindow"
        Title="Creare Cont Client" Height="450" Width="350" WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <viewmodels:RegisterViewModel />
    </Window.DataContext>

    <StackPanel Margin="30">
        <TextBlock Text="Creare Cont Nou" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>

        <TextBlock Text="Nume:*"/>
        <TextBox Text="{Binding Nume, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

        <TextBlock Text="Prenume:*"/>
        <TextBox Text="{Binding Prenume, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

        <TextBlock Text="Email:*"/>
        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

        <TextBlock Text="Telefon:"/>
        <TextBox Text="{Binding Telefon, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

        <TextBlock Text="Adresă Livrare:"/>
        <TextBox Text="{Binding Adresa, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

        <TextBlock Text="Parolă:*"/>
        <PasswordBox core:PasswordHelper.Password="{Binding Parola, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

        <TextBlock Text="{Binding MesajEroare}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <Button Content="Înregistrare" 
                Command="{Binding RegisterCommand}" 
                CommandParameter="{Binding ElementName=thisRegisterWindow}" 
                Padding="5" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
    </StackPanel>
</Window>